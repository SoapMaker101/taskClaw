# Copy to /opt/task-broker/.env on the server (chmod 600). Do not commit real values.

STAFF_BOT_TOKEN=123456:ABC_from_BotFather_staff_bot
CHAIRMAN_BOT_TOKEN=123456:ABC_from_BotFather_personal_openclaw_bot
CHAIRMAN_CHAT_ID=YOUR_NUMERIC_TELEGRAM_USER_ID
BROKER_API_SECRET=use_openssl_rand_hex_32

# REST bind (plan: localhost only)
BROKER_HOST=127.0.0.1
BROKER_PORT=8089

# SQLite path (created automatically)
DATABASE_PATH=/opt/task-broker/data/tasks.db

# File attachments
UPLOAD_DIR=/opt/task-broker/data/files
MAX_FILE_SIZE_MB=20

# Reminders: local window [start, end) and min span (hours) for pre-deadline nudges
REMINDER_TIMEZONE=Europe/Moscow
REMINDER_WINDOW_START_HOUR=8
REMINDER_WINDOW_END_HOUR=19
LONG_TASK_REMINDER_MIN_HOURS=72

# Fan-out to Telegram
MAX_GROUP_MEMBERS=200
